---
import '../styles/tokens.css';
import '../styles/global.css';
import { ui } from '../i18n';

type JsonLd = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title: string;
  description?: string;
  pagefindFilters?: string[];
  noindex?: boolean;
  image?: string;
  jsonLd?: JsonLd;
}

const { title, description, pagefindFilters, noindex = false, image, jsonLd } = Astro.props;
const desc = description ?? ui.site.description;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const pathname = Astro.url.pathname;
const ogImage = Astro.site ? new URL(image ?? '/og-image.png', Astro.site).toString() : undefined;
const siteJsonLd: JsonLd | undefined = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          name: ui.site.name,
          url: Astro.site.toString(),
        },
        {
          '@type': 'WebSite',
          name: ui.site.name,
          url: Astro.site.toString(),
          potentialAction: {
            '@type': 'SearchAction',
            target: {
              '@type': 'EntryPoint',
              urlTemplate: `${new URL('/search/', Astro.site).toString()}?q={search_term_string}`,
            },
            'query-input': 'required name=search_term_string',
          },
        },
      ],
    }
  : undefined;

const primaryNavItems = [
  { href: '/what-is/', label: ui.nav.about },
  { href: '/curriculum/', label: ui.nav.curriculum },
  { href: '/for-teachers/', label: ui.nav.forTeachers },
  { href: '/for-leaders/', label: ui.nav.forLeaders },
  { href: '/support/', label: ui.nav.support },
];

const referenceNavItems = [
  { href: '/standards/', label: ui.nav.standards },
  { href: '/docs/', label: ui.nav.docs },
  { href: '/search/', label: ui.nav.search },
];

const footerNavItems = [
  { href: '/', label: ui.nav.home },
  ...primaryNavItems,
  ...referenceNavItems,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2b3a42" />
    <title>{title} · {ui.site.name}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={ui.site.name} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:type" content="image/png" />}
    {ogImage && <meta property="og:image:alt" content={ui.site.name} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {siteJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <script is:inline>
      // Apply theme before first paint to avoid a flash. Respects a stored
      // choice, then falls back to the system preference.
      (() => {
        try {
          const stored = localStorage.getItem('nwo-theme');
          const theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <script is:inline>
      // Apply the "show internal IDs" preference before paint so IDs never
      // flash for casual visitors (they are hidden by default in CSS).
      (() => {
        try {
          if (localStorage.getItem('wec-show-ids') === 'on') {
            document.documentElement.setAttribute('data-show-ids', 'on');
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    {pagefindFilters?.map((f) => <span data-pagefind-filter={f} hidden></span>)}
    <a class="skip-link" href="#main">{ui.nav.skipToContent}</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">
          <span class="brand__name">{ui.site.name}</span>
          <span class="brand__short">{ui.site.short}</span>
        </a>
        <div class="site-header__tools">
          <form class="header-search" action="/search/" method="get" role="search">
            <label class="sr-only" for="header-search-input">{ui.nav.search}</label>
            <input
              id="header-search-input"
              type="search"
              name="q"
              placeholder={ui.search.shortPlaceholder}
              autocomplete="off"
            />
          </form>
          <nav class="site-nav" aria-label="Primary">
            {
              primaryNavItems.map((item) => (
                <a
                  href={item.href}
                  aria-current={pathname === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            data-label-dark={ui.nav.themeToDark}
            data-label-light={ui.nav.themeToLight}
            aria-label={ui.nav.theme}
          >
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <details class="mobile-nav">
            <summary class="mobile-nav__toggle" aria-label={ui.nav.menu}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </summary>
            <div class="mobile-nav__panel">
              <nav aria-label="Primary">
                {
                  [...primaryNavItems, ...referenceNavItems].map((item) => (
                    <a
                      href={item.href}
                      aria-current={pathname === item.href ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  ))
                }
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <p class="site-footer__brand">{ui.site.name}</p>
          <p>{ui.footer.tagline}</p>
        </div>
        <nav class="site-footer__nav" aria-label="Footer">
          {
            footerNavItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
          <a href="/sources/">{ui.nav.sources}</a>
        </nav>
      </div>
      <div class="container site-footer__legal">
        <p>{ui.footer.license}</p>
        <p style="margin-top:0.35rem;font-size:0.8rem">
          <button type="button" class="ids-toggle-footer" data-ids-toggle data-label-on={ui.nav.hideIds} data-label-off={ui.nav.showIds} aria-pressed="false">
            {ui.nav.showIds}
          </button>
        </p>
      </div>
    </footer>
    <script is:inline>
      // "/" focuses the header search input (unless typing elsewhere).
      document.addEventListener('keydown', (event) => {
        const target = event.target;
        const el = target instanceof Element ? target : null;
        const isTyping =
          el &&
          (el.closest('input, textarea, [contenteditable]') ||
            el.tagName === 'SELECT');
        if (event.key === '/' && !isTyping) {
          const input = document.getElementById('header-search-input');
          if (input) {
            event.preventDefault();
            input.focus();
          }
        }
      });
    </script>
    <script is:inline>
      (() => {
        const input = document.getElementById('header-search-input');
        if (!input) return;

        let pagefindPromise;
        const loadPagefind = () => {
          if (!pagefindPromise) {
            pagefindPromise = import('/pagefind/pagefind.js')
              .then(async (pagefind) => {
                await pagefind.init();
                return pagefind;
              })
              .catch(() => null);
          }
          return pagefindPromise;
        };

        input.addEventListener('focus', loadPagefind, { once: true });
        input.addEventListener('pointerenter', loadPagefind, { once: true });
        input.addEventListener('input', async () => {
          const term = input.value.trim();
          if (!term) return;
          const pagefind = await loadPagefind();
          pagefind?.preload(term);
        });
      })();
    </script>
    <script is:inline>
      // Theme toggle: keep label and stored preference in sync.
      (() => {
        const btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        const labels = {
          dark: { next: 'light', label: btn.dataset.labelLight },
          light: { next: 'dark', label: btn.dataset.labelDark },
        };
        const sync = () => {
          const current =
            document.documentElement.getAttribute('data-theme') || 'light';
          btn.setAttribute('aria-label', labels[current].label);
        };
        btn.addEventListener('click', () => {
          const current =
            document.documentElement.getAttribute('data-theme') || 'light';
          const next = labels[current].next;
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('nwo-theme', next);
          } catch {}
          sync();
        });
        sync();
      })();
    </script>
    <script is:inline>
      // "Show IDs" toggle — now a text link in the footer legal row instead of
      // a toolbar button. Reads/writes `data-show-ids` on <html> and persists
      // the choice in localStorage.
      (() => {
        const btns = document.querySelectorAll('[data-ids-toggle]');
        if (!btns.length) return;
        const sync = () => {
          const on =
            document.documentElement.getAttribute('data-show-ids') === 'on';
          btns.forEach(function (btn) {
            var label = on ? btn.dataset.labelOn : btn.dataset.labelOff;
            btn.setAttribute('aria-pressed', String(on));
            var span = btn.querySelector('[data-ids-label]');
            if (span) span.textContent = label;
            if (!span) btn.textContent = label;
          });
        };
        btns.forEach(function (btn) {
          btn.addEventListener('click', () => {
            const on =
              document.documentElement.getAttribute('data-show-ids') === 'on';
            if (on) {
              document.documentElement.removeAttribute('data-show-ids');
              try { localStorage.removeItem('wec-show-ids'); } catch {}
            } else {
              document.documentElement.setAttribute('data-show-ids', 'on');
              try { localStorage.setItem('wec-show-ids', 'on'); } catch {}
            }
            sync();
          });
        });
        sync();
      })();
    </script>
  </body>
</html>
