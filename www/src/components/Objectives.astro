---
import { ui } from '../i18n';
import { standardPath } from '../lib/links';

interface Props {
  objectives: Array<{ id: string; text: string }>;
}

const { objectives } = Astro.props;
---

{
  objectives.length > 0 && (
    <>
      <p class="section-label">{ui.common.objectives}</p>
      <ul class="objective-list">
        {objectives.map((o) => {
          const href = standardPath(o.id);
          return (
            <li>
              {href ? (
                <a class="obj-id id" href={href}>{o.id}</a>
              ) : (
                <span class="obj-id id">{o.id}</span>
              )}
              <span>{o.text}</span>
            </li>
          );
        })}
      </ul>
    </>
  )
}
