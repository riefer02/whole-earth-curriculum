---
import { ui } from '../i18n';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  // Markdown headings as returned by Astro's `render()` — rendered into a
  // static list at build time so the table of contents works with JavaScript
  // disabled and is visible to search engines.
  headings?: TocHeading[];
}

const { headings = [] } = Astro.props;
const items = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label={ui.common.onThisPage} data-pagefind-ignore>
      <p class="toc__title">{ui.common.onThisPage}</p>
      <ul class="toc__list">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'toc__item toc__item--sub' : 'toc__item'}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
