---
interface Crumb {
  label?: string;
  href?: string;
  id?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((c) => (
        <li>
          {c.href ? (
            <a href={c.href}>
              {c.id && <span class="id">{c.id}</span>}
              {c.label}
            </a>
          ) : (
            <span>
              {c.id && <span class="id">{c.id}</span>}
              {c.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
