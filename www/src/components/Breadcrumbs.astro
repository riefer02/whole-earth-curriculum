---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((c) => (
        <li>
          {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
