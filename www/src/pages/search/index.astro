---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
---

<BaseLayout title={ui.search.title}>
  <div class="container container--prose">
    <h1 class="page-title">{ui.search.title}</h1>

    <form id="search-form" method="get" action="/search/">
      <div class="search-bar">
        <svg class="search-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="search-input"
          name="q"
          class="search-bar__input"
          placeholder={ui.search.placeholder}
          value=""
          autocomplete="off"
          autofocus
        />
        <button type="submit" class="btn btn--primary search-bar__btn">
          {ui.nav.search}
        </button>
      </div>
    </form>

    <div id="search-results" class="search-results">
      <p id="search-placeholder" class="muted" style="font-size:1rem; margin-top:1.5rem">{ui.search.startTyping}</p>
    </div>

    <p class="note" style="margin-top: 2.5rem; font-size:0.8rem">{ui.search.hint}</p>
  </div>
</BaseLayout>

<script is:inline>
  (async function () {
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') || '';

    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const placeholder = document.getElementById('search-placeholder');
    if (!form || !input || !results) return;

    // Show a loading state immediately if the URL carries a query, so the user
    // never sees "Start typing" flash before Pagefind boots.
    if (initialQuery) {
      input.value = initialQuery;
      if (placeholder) placeholder.remove();
      results.innerHTML = '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Loading search\u2026</p>';
    }

    let pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
    } catch (err) {
      console.error('Pagefind failed to load:', err);
      results.innerHTML = '<p class="muted">Search is not available right now.</p>';
      return;
    }

    // Pre-warm the index for the initial query so the first search is instant.
    if (initialQuery) {
      try { await pagefind.preload(initialQuery); } catch (_) { /* best-effort */ }
    }

    let activeRequest = 0;

    async function doSearch(query) {
      const q = query.trim();
      if (!q) {
        results.innerHTML = '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Start typing to search.</p>';
        return;
      }

      const reqId = ++activeRequest;
      results.innerHTML = '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Searching\u2026</p>';

      let search;
      try {
        search = await pagefind.search(q);
      } catch (err) {
        console.error('Search failed:', err);
        if (reqId !== activeRequest) return;
        results.innerHTML = '<p class="muted">Something went wrong. Try again.</p>';
        return;
      }

      if (reqId !== activeRequest) return;

      if (!search || search.results.length === 0) {
        results.innerHTML =
          '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Nothing matched &ldquo;' + esc(q) + '&rdquo;.</p>';
        return;
      }

      const count = search.results.length;
      let html = '<p class="search-count">' + count + ' result' + (count !== 1 ? 's' : '') + '</p>';

      for (const r of search.results) {
        const data = await r.data();
        const title = (data.meta && data.meta.title) || r.id;
        const url = data.url;
        const excerpt = data.excerpt || '';

        const filters = [];
        const meta = data.meta || {};
        for (const key in meta) {
          if (key === 'title' || key === 'image' || key === 'image_alt') continue;
          if (meta[key]) filters.push(String(meta[key]));
        }
        const dataFilters = data.filters || {};
        for (const fk in dataFilters) {
          dataFilters[fk].forEach(function (v) { filters.push(fk + ': ' + v); });
        }

        let badges = '';
        filters.forEach(function (f) {
          badges += '<span class="badge search-result__badge">' + esc(f) + '</span>';
        });

        html +=
          '<a class="search-result" href="' + url + '">' +
          '<h3 class="search-result__title">' + title + '</h3>' +
          '<p class="search-result__excerpt">' + excerpt + '</p>' +
          (badges ? '<div class="badge-row" style="margin-top:0.35rem">' + badges + '</div>' : '') +
          '</a>';
      }

      results.innerHTML = html;
    }

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    let timer;
    input.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(function () {
        const val = input.value;
        doSearch(val);
        const u = new URL(window.location.href);
        if (val.trim()) u.searchParams.set('q', val.trim());
        else u.searchParams.delete('q');
        history.replaceState(null, '', u.toString());
      }, 250);
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const val = input.value.trim();
      if (!val) return;
      const u = new URL(window.location.href);
      u.searchParams.set('q', val);
      window.location.href = u.toString();
    });

    if (initialQuery) doSearch(initialQuery);
  })();
</script>