---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
---

<BaseLayout title={ui.search.title} noindex>
  <div class="container">
    <h1 class="page-title">{ui.search.title}</h1>

    <form id="search-form" method="get" action="/search/">
      <div class="search-bar">
        <svg class="search-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="search-input"
          name="q"
          class="search-bar__input"
          placeholder={ui.search.placeholder}
          value=""
          autocomplete="off"
          autofocus
        />
        <button type="submit" class="btn btn--primary search-bar__btn">
          {ui.nav.search}
        </button>
      </div>
    </form>

    <div class="search-filters" id="search-filters" hidden>
      <span class="search-filters__label">{ui.search.filter}</span>
      <label class="facet">
        <span class="facet__name">{ui.search.type}</span>
        <select id="facet-type" class="facet__select"></select>
      </label>
      <label class="facet">
        <span class="facet__name">{ui.search.grade}</span>
        <select id="facet-grade" class="facet__select"></select>
      </label>
      <label class="facet">
        <span class="facet__name">{ui.search.subject}</span>
        <select id="facet-domain" class="facet__select"></select>
      </label>
      <label class="facet">
        <span class="facet__name">{ui.search.pillar}</span>
        <select id="facet-pillar" class="facet__select"></select>
      </label>
      <button type="button" id="facet-clear" class="btn btn--ghost btn--sm">{ui.search.clear}</button>
    </div>

    <div
      id="search-results"
      class="search-results"
      data-show-more={ui.search.showMore}
      aria-live="polite"
    >
      <p id="search-placeholder" class="muted" style="font-size:1rem; margin-top:1.5rem">{ui.search.startTyping}</p>
    </div>

    <p class="note" style="margin-top: 2.5rem; font-size:0.8rem">{ui.search.hint}</p>
  </div>
</BaseLayout>

<script is:inline>
  (async function () {
    const RESULTS_PER_PAGE = 20;
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q') || '';

    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const filtersEl = document.getElementById('search-filters');
    const clearBtn = document.getElementById('facet-clear');
    if (!form || !input || !results || !filtersEl || !clearBtn) return;

    const FACETS = [
      { key: 'type', el: document.getElementById('facet-type') },
      { key: 'grade', el: document.getElementById('facet-grade') },
      { key: 'domain', el: document.getElementById('facet-domain') },
      { key: 'pillar', el: document.getElementById('facet-pillar') },
    ];

    let pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
    } catch (err) {
      console.error('Pagefind failed to load:', err);
      results.innerHTML = '<p class="muted">Search is not available right now.</p>';
      return;
    }

    let available = {};
    try {
      available = await pagefind.filters();
    } catch (_) {}

    const ALL = '';

    function populate(sel, values) {
      sel.innerHTML = '';
      const allOpt = document.createElement('option');
      allOpt.value = ALL;
      allOpt.textContent = 'All';
      sel.appendChild(allOpt);
      const keys = Object.keys(values || {}).sort();
      keys.forEach(function (k) {
        const o = document.createElement('option');
        o.value = k;
        o.textContent = k + ' (' + (values[k] || 0) + ')';
        sel.appendChild(o);
      });
    }

    FACETS.forEach(function (f) {
      if (f.el) populate(f.el, available[f.key] || {});
    });

    function currentFilters() {
      const f = {};
      FACETS.forEach(function (facet) {
        if (facet.el && facet.el.value) f[facet.key] = facet.el.value;
      });
      return f;
    }

    function showSpinner() {
      results.innerHTML =
        '<p class="search-loading"><span class="spinner" aria-hidden="true"></span> Searching\u2026</p>';
    }

    let activeRequest = 0;

    async function run(debounced) {
      const reqId = ++activeRequest;
      const q = input.value.trim();
      if (!q) {
        results.innerHTML = '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Start typing to search.</p>';
        return;
      }

      showSpinner();

      let search;
      try {
        const options = { filters: currentFilters() };
        search = debounced
          ? await pagefind.debouncedSearch(q, options, 250)
          : await pagefind.search(q, options);
      } catch (err) {
        console.error('Search failed:', err);
        if (reqId !== activeRequest) return;
        results.innerHTML = '<p class="muted">Something went wrong. Try again.</p>';
        return;
      }

      if (reqId !== activeRequest || search === null) return;

      if (!search || search.results.length === 0) {
        results.innerHTML =
          '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Nothing matched &ldquo;' + esc(q) + '&rdquo;.</p>';
        return;
      }

      const count = search.results.length;
      results.replaceChildren();

      const countEl = document.createElement('p');
      countEl.className = 'search-count';
      countEl.textContent = count + ' result' + (count !== 1 ? 's' : '');
      results.appendChild(countEl);

      const list = document.createElement('div');
      results.appendChild(list);

      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'btn btn--ghost search-results__more';
      more.textContent = results.dataset.showMore || 'Show more results';
      results.appendChild(more);

      let rendered = 0;
      async function appendPage() {
        more.disabled = true;
        const batch = search.results.slice(rendered, rendered + RESULTS_PER_PAGE);

        let data;
        try {
          data = await Promise.all(batch.map(function (result) { return result.data(); }));
        } catch (err) {
          console.error('Search results failed to load:', err);
          if (reqId === activeRequest) more.disabled = false;
          return;
        }

        if (reqId !== activeRequest) return;
        data.forEach(function (item, index) {
          list.appendChild(resultElement(item, batch[index].id));
        });
        rendered += batch.length;
        more.hidden = rendered >= count;
        more.disabled = false;
      }

      more.addEventListener('click', appendPage);
      await appendPage();
    }

    function resultElement(data, fallbackTitle) {
      const link = document.createElement('a');
      link.className = 'search-result';
      link.href = safeResultUrl(data.url);

      const title = document.createElement('h3');
      title.className = 'search-result__title';
      title.textContent = (data.meta && data.meta.title) || fallbackTitle;
      link.appendChild(title);

      const excerpt = document.createElement('p');
      excerpt.className = 'search-result__excerpt';
      excerpt.innerHTML = data.excerpt || '';
      link.appendChild(excerpt);

      const values = [];
      const meta = data.meta || {};
      for (const key in meta) {
        if (key === 'title' || key === 'image' || key === 'image_alt') continue;
        if (meta[key]) values.push(String(meta[key]));
      }
      const dataFilters = data.filters || {};
      for (const key in dataFilters) {
        const entries = Array.isArray(dataFilters[key]) ? dataFilters[key] : [dataFilters[key]];
        entries.forEach(function (value) { values.push(key + ': ' + value); });
      }

      if (values.length) {
        const badges = document.createElement('div');
        badges.className = 'badge-row search-result__badges';
        values.forEach(function (value) {
          const badge = document.createElement('span');
          badge.className = 'badge search-result__badge';
          badge.textContent = value;
          badges.appendChild(badge);
        });
        link.appendChild(badges);
      }

      return link;
    }

    function safeResultUrl(value) {
      try {
        const url = new URL(value, window.location.origin);
        if (url.origin !== window.location.origin) return '/';
        return url.pathname + url.search + url.hash;
      } catch (_) {
        return '/';
      }
    }

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    function syncUrl() {
      const u = new URL(window.location.href);
      const q = input.value.trim();
      if (q) u.searchParams.set('q', q); else u.searchParams.delete('q');
      FACETS.forEach(function (f) {
        if (f.el && f.el.value) u.searchParams.set(f.key, f.el.value);
        else u.searchParams.delete(f.key);
      });
      history.replaceState(null, '', u.toString());
    }

    input.addEventListener('input', function () {
      run(true);
      syncUrl();
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      run(false);
      syncUrl();
    });

    FACETS.forEach(function (f) {
      if (f.el) f.el.addEventListener('change', function () { run(false); syncUrl(); });
    });

    clearBtn.addEventListener('click', function () {
      FACETS.forEach(function (f) { if (f.el) f.el.value = ALL; });
      run(false);
      syncUrl();
    });

    if (initialQ) {
      input.value = initialQ;
    }
    FACETS.forEach(function (f) {
      if (f.el && params.get(f.key)) f.el.value = params.get(f.key);
    });
    filtersEl.hidden = false;
    if (initialQ) run(false);
  })();
</script>
