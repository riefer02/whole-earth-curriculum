---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
---

<BaseLayout title={ui.search.title}>
  <div class="container">
    <h1 class="page-title">{ui.search.title}</h1>

    <form id="search-form" method="get" action="/search/">
      <div class="search-bar">
        <svg class="search-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="search-input"
          name="q"
          class="search-bar__input"
          placeholder={ui.search.placeholder}
          value=""
          autocomplete="off"
          autofocus
        />
        <button type="submit" class="btn btn--primary search-bar__btn">
          {ui.nav.search}
        </button>
      </div>
    </form>

    <div class="search-filters" id="search-filters" hidden>
      <span class="search-filters__label">{ui.search.filter}</span>
      <label class="facet">
        <span class="facet__name">{ui.search.type}</span>
        <select id="facet-type" class="facet__select"></select>
      </label>
      <label class="facet">
        <span class="facet__name">{ui.search.grade}</span>
        <select id="facet-grade" class="facet__select"></select>
      </label>
      <label class="facet">
        <span class="facet__name">{ui.search.subject}</span>
        <select id="facet-domain" class="facet__select"></select>
      </label>
      <label class="facet">
        <span class="facet__name">{ui.search.pillar}</span>
        <select id="facet-pillar" class="facet__select"></select>
      </label>
      <button type="button" id="facet-clear" class="btn btn--ghost btn--sm">{ui.search.clear}</button>
    </div>

    <div id="search-results" class="search-results" aria-live="polite">
      <p id="search-placeholder" class="muted" style="font-size:1rem; margin-top:1.5rem">{ui.search.startTyping}</p>
    </div>

    <p class="note" style="margin-top: 2.5rem; font-size:0.8rem">{ui.search.hint}</p>
  </div>
</BaseLayout>

<script is:inline>
  (async function () {
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q') || '';

    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const filtersEl = document.getElementById('search-filters');
    const clearBtn = document.getElementById('facet-clear');
    if (!form || !input || !results || !filtersEl || !clearBtn) return;

    const FACETS = [
      { key: 'type', el: document.getElementById('facet-type') },
      { key: 'grade', el: document.getElementById('facet-grade') },
      { key: 'domain', el: document.getElementById('facet-domain') },
      { key: 'pillar', el: document.getElementById('facet-pillar') },
    ];

    let pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
    } catch (err) {
      console.error('Pagefind failed to load:', err);
      results.innerHTML = '<p class="muted">Search is not available right now.</p>';
      return;
    }

    // Load the available filter values and populate the facet selects.
    let available = {};
    try {
      available = await pagefind.filters();
    } catch (_) { /* filters unavailable — leave selects empty */ }

    const ALL = '';

    function populate(sel, values) {
      sel.innerHTML = '';
      const allOpt = document.createElement('option');
      allOpt.value = ALL;
      allOpt.textContent = 'All';
      sel.appendChild(allOpt);
      const keys = Object.keys(values || {}).sort();
      keys.forEach(function (k) {
        const o = document.createElement('option');
        o.value = k;
        o.textContent = k + ' (' + (values[k] || 0) + ')';
        sel.appendChild(o);
      });
    }

    FACETS.forEach(function (f) {
      if (f.el) populate(f.el, available[f.key] || {});
    });

    function currentFilters() {
      const f = {};
      FACETS.forEach(function (facet) {
        if (facet.el && facet.el.value) f[facet.key] = facet.el.value;
      });
      return f;
    }

    function showSpinner() {
      results.innerHTML =
        '<p class="search-loading"><span class="spinner" aria-hidden="true"></span> Searching\u2026</p>';
    }

    let activeRequest = 0;

    async function run() {
      const q = input.value.trim();
      if (!q) {
        results.innerHTML = '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Start typing to search.</p>';
        return;
      }

      const reqId = ++activeRequest;
      showSpinner();

      let search;
      try {
        search = await pagefind.search(q, { filters: currentFilters() });
      } catch (err) {
        console.error('Search failed:', err);
        if (reqId !== activeRequest) return;
        results.innerHTML = '<p class="muted">Something went wrong. Try again.</p>';
        return;
      }

      if (reqId !== activeRequest) return;

      if (!search || search.results.length === 0) {
        results.innerHTML =
          '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Nothing matched &ldquo;' + esc(q) + '&rdquo;.</p>';
        return;
      }

      const count = search.results.length;
      let html = '<p class="search-count">' + count + ' result' + (count !== 1 ? 's' : '') + '</p>';

      for (const r of search.results) {
        const data = await r.data();
        const title = (data.meta && data.meta.title) || r.id;
        const url = data.url;
        const excerpt = data.excerpt || '';

        const filters = [];
        const meta = data.meta || {};
        for (const key in meta) {
          if (key === 'title' || key === 'image' || key === 'image_alt') continue;
          if (meta[key]) filters.push(String(meta[key]));
        }
        const dataFilters = data.filters || {};
        for (const fk in dataFilters) {
          dataFilters[fk].forEach(function (v) { filters.push(fk + ': ' + v); });
        }

        let badges = '';
        filters.forEach(function (f) {
          badges += '<span class="badge search-result__badge">' + esc(f) + '</span>';
        });

        html +=
          '<a class="search-result" href="' + url + '">' +
          '<h3 class="search-result__title">' + title + '</h3>' +
          '<p class="search-result__excerpt">' + excerpt + '</p>' +
          (badges ? '<div class="badge-row" style="margin-top:0.35rem">' + badges + '</div>' : '') +
          '</a>';
      }

      results.innerHTML = html;
    }

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    function syncUrl() {
      const u = new URL(window.location.href);
      const q = input.value.trim();
      if (q) u.searchParams.set('q', q); else u.searchParams.delete('q');
      FACETS.forEach(function (f) {
        if (f.el && f.el.value) u.searchParams.set(f.key, f.el.value);
        else u.searchParams.delete(f.key);
      });
      history.replaceState(null, '', u.toString());
    }

    let timer;
    input.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(function () { run(); syncUrl(); }, 250);
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      run();
      syncUrl();
    });

    FACETS.forEach(function (f) {
      if (f.el) f.el.addEventListener('change', function () { run(); syncUrl(); });
    });

    clearBtn.addEventListener('click', function () {
      FACETS.forEach(function (f) { if (f.el) f.el.value = ALL; });
      run();
      syncUrl();
    });

    // Initial state from URL.
    if (initialQ) {
      input.value = initialQ;
    }
    FACETS.forEach(function (f) {
      if (f.el && params.get(f.key)) f.el.value = params.get(f.key);
    });
    // Reveal filters once populated.
    filtersEl.hidden = false;
    if (initialQ) run();
  })();
</script>