---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';

const q = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout title={ui.search.title}>
  <div class="container container--prose">
    <h1 class="page-title">{ui.search.title}</h1>

    <form id="search-form" method="get" action={Astro.url.pathname}>
      <div class="search-bar">
        <svg class="search-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="search-input"
          name="q"
          class="search-bar__input"
          placeholder={ui.search.placeholder}
          value={q}
          autocomplete="off"
          autofocus={!q}
        />
        <button type="submit" class="btn btn--primary search-bar__btn">
          {ui.nav.search}
        </button>
      </div>
    </form>

    <div id="search-results" class="search-results">
      {!q && <p class="muted" style="font-size:1rem; margin-top:1.5rem">Start typing to search.</p>}
    </div>

    <p class="note" style="margin-top: 2.5rem; font-size:0.8rem">{ui.search.hint}</p>
  </div>
</BaseLayout>

<script>
  import { debounce } from '../../lib/debounce.ts';

  // Read the initial query from the URL (already rendered server-side to
  // prefill the input; also available via Astro.url at build time, but
  // we read it again client-side in case of a shared link).
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') ?? '';

  const form = document.getElementById('search-form') as HTMLFormElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results') as HTMLDivElement | null;
  if (!form || !input || !results) throw new Error('missing elements');

  // @ts-expect-error  pagefind.js generated by postbuild, not available at type-check time
  const PAGE = (await import('/pagefind/pagefind.js')).default;

  let activeRequest = 0;

  async function doSearch(query: string) {
    const q = query.trim();
    if (!q) {
      results!.innerHTML = '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Start typing to search.</p>';
      return;
    }

    const reqId = ++activeRequest;
    results!.innerHTML = '<p class="muted" style="font-size:1rem; margin-top:1.5rem">Searching&hellip;</p>';

    let search;
    try {
      search = await PAGE.search(q);
    } catch {
      if (reqId !== activeRequest) return;
      results!.innerHTML = '<p class="muted">Something went wrong. Try again.</p>';
      return;
    }

    if (reqId !== activeRequest) return;

    if (!search || search.results.length === 0) {
      results!.innerHTML =
        `<p class="muted" style="font-size:1rem; margin-top:1.5rem">Nothing matched &ldquo;${escape(q)}&rdquo;.</p>`;
      return;
    }

    const count = search.results.length;
    let html = `<p class="search-count">${count} result${count !== 1 ? 's' : ''}</p>`;

    for (const r of search.results) {
      const data = await r.data();
      // data.meta.title contains <mark> tags; excerpt is an HTML snippet.
      const title = data.meta?.title ?? r.id;
      const url = data.url;
      const excerpt = data.excerpt ?? '';

      // Collect filter labels from the result's meta fields.
      const filters: string[] = [];
      for (const [key, val] of Object.entries(data.meta ?? {})) {
        if (key === 'title' || key === 'image' || key === 'image_alt') continue;
        if (val) filters.push(String(val));
      }
      for (const [key, vals] of Object.entries(data.filters ?? {} as Record<string, string[]>)) {
        for (const v of (vals as unknown as string[])) {
          filters.push(`${key}: ${v}`);
        }
      }

      const badgeHTML = filters.map((f) => `<span class="badge search-result__badge">${escape(f)}</span>`).join('');

      html += `<a class="search-result" href="${escape(url)}">
        <h3 class="search-result__title">${title}</h3>
        <p class="search-result__excerpt">${excerpt}</p>
        ${badgeHTML ? '<div class="badge-row" style="margin-top:0.35rem">' + badgeHTML + '</div>' : ''}
      </a>`;
    }

    results!.innerHTML = html;
  }

  const debouncedSearch = debounce((q: string) => {
    doSearch(q);
    const u = new URL(window.location.href);
    if (q.trim()) u.searchParams.set('q', q.trim());
    else u.searchParams.delete('q');
    history.replaceState(null, '', u.toString());
  }, 250);

  input.addEventListener('input', () => {
    debouncedSearch(input.value);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const qVal = input.value.trim();
    if (!qVal) return;
    // Navigate to shareable URL which triggers a page load + the initialQuery branch.
    const u = new URL(window.location.href);
    u.searchParams.set('q', qVal);
    window.location.href = u.toString();
  });

  if (initialQuery) {
    input.value = initialQuery;
    doSearch(initialQuery);
  }

  function escape(s: string): string {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }
</script>