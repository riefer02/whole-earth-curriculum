---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
import { gradePath, unitPath, lessonPath } from '../../lib/links';
import { lessonsByUnit, scopeByGrade } from '../../lib/data';
import { schoolDayForToday, lessonForSchoolDay, isSchoolActive } from '../../lib/teachToday';

const t = ui.pages.forTeachers;
const grades = Array.from({ length: 13 }, (_, i) => i);

const [scopes, lessons] = await Promise.all([
  getCollection('scopes'),
  getCollection('lessons'),
]);

const scopeMap = scopeByGrade(scopes);
const lessonMap = lessonsByUnit(lessons);

const today = new Date();
const isActive = isSchoolActive(today);
const schoolDay = isActive ? schoolDayForToday(today) : 1;

function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// Pre-render the "this week" result HTML for every grade at build time so the
// page is useful with JavaScript disabled. The browser recomputes the same
// answer for the visitor's actual date on load (see the script below), since
// a static build's date goes stale after deploy.
const htmlByGrade: Record<string, string> = {};
for (let g = 0; g <= 12; g++) {
  const scope = scopeMap.get(g);
  const tw = scope ? lessonForSchoolDay(scope, lessonMap, schoolDay) : null;
  if (tw) {
    const unitTitle = tw.unit.title ?? tw.unit.unit_id ?? 'Unit';
    const lessonTitle = tw.lesson.data.title ?? tw.lesson.data.id ?? 'Lesson';
    const lead = isActive
      ? `<strong>${t.todayIs} ${schoolDay}.</strong> ${t.thisWeek}`
      : `<strong>${t.comingSoon}</strong> ${t.firstLesson}`;
    htmlByGrade[g] =
      `${lead} <a href="${unitPath(tw.unit.unit_id ?? '')}">${esc(unitTitle)}</a>` +
      ` &mdash; <a href="${lessonPath(tw.lesson.data.id ?? '')}">${esc(lessonTitle)}</a>`;
  } else {
    htmlByGrade[g] =
      `<strong>${t.notAuthored} <a href="${gradePath(g)}">${ui.gradeLabel(g)}</a> ${t.browseFullYear}</strong>`;
  }
}

// Compact per-grade catalog so the browser can answer "which lesson is it
// today?" for the visitor's own date without another round trip: unit day
// ranges plus the ordered lesson id/title pairs of each unit.
const teachCatalog: Record<
  string,
  {
    units: { id: string; title: string; start: number; end: number }[];
    lessons: Record<string, [string, string][]>;
  }
> = {};
for (let g = 0; g <= 12; g++) {
  const scope = scopeMap.get(g);
  if (!scope) continue;
  const units = (scope.data.units ?? []).filter(
    (u) =>
      u.unit_id &&
      typeof u.start_day === 'number' &&
      typeof u.end_day === 'number',
  );
  if (!units.length) continue;
  const lessons: Record<string, [string, string][]> = {};
  for (const u of units) {
    const list = lessonMap.get(u.unit_id ?? '') ?? [];
    if (list.length) {
      lessons[u.unit_id ?? ''] = list.map((l) => [
        l.data.id ?? '',
        l.data.title ?? l.data.id ?? 'Lesson',
      ]);
    }
  }
  teachCatalog[g] = {
    units: units.map((u) => ({
      id: u.unit_id ?? '',
      title: u.title ?? u.unit_id ?? 'Unit',
      start: u.start_day as number,
      end: u.end_day as number,
    })),
    lessons,
  };
}

const defaultGrade = 1;
const jsonData = JSON.stringify({
  catalog: teachCatalog,
  copy: {
    todayIs: t.todayIs,
    thisWeek: t.thisWeek,
    comingSoon: t.comingSoon,
    firstLesson: t.firstLesson,
    notAuthored: t.notAuthored,
    browseFullYear: t.browseFullYear,
    gradeNames: grades.map((g) => ui.gradeLabel(g)),
  },
  // Server-rendered fallback (build-date answer) for no-JavaScript visitors.
  fallback: htmlByGrade,
}).replace(/</g, '\\u003c');
---

<BaseLayout title={t.title} description={t.description}>
  <section class="hero">
    <div class="container">
      <p class="hero__kicker">{t.kicker}</p>
      <h1 class="hero__title">{t.heroTitle}</h1>
      <p class="hero__subtitle">{t.heroSubtitle}</p>
    </div>
  </section>

  <section class="home-section" id="this-week-section">
    <div class="container">
      <h2>{t.whereTitle}</h2>
      {isActive ? (
        <p class="lede">{t.whereIntro}</p>
      ) : (
        <p class="lede">{t.offSeasonNote} {t.whereIntro}</p>
      )}

      <div class="teach-today">
        <div class="teach-today__control">
          <label for="grade-select">{t.gradeLabel}</label>
          <select id="grade-select" name="grade">
            {grades.map((g) => (
              <option value={g} selected={g === defaultGrade}>
                {ui.gradeLabel(g)}
              </option>
            ))}
          </select>
        </div>
        <p class="teach-today__result" id="teach-result" set:html={htmlByGrade[defaultGrade]} />
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <h2>{t.chooseTitle}</h2>
      <p class="lede">{t.chooseIntro}</p>
      <div class="grades-nav">
        {grades.map((g) => (
          <a class="grades-nav__item" href={gradePath(g)}>
            {ui.gradeLabel(g)}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <h2>{t.madeTitle}</h2>
      <div class="grid">
        {t.made.map((m) => (
          <div class="card">
            <h3 class="card__title">{m.title}</h3>
            <p class="card__meta">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <h2>{t.fitTitle}</h2>
      <p class="lede">{t.fitIntro}</p>
      <ul class="prose">
        {t.fitSteps.map((s) => (
          <li>
            <strong>{s.title}</strong> &mdash; {s.body}
          </li>
        ))}
      </ul>
      <div class="cta-row">
        <a class="btn btn--primary" href="/curriculum/">{t.startCta}</a>
        <a class="btn btn--ghost" href="/support/?type=pilot#interest">{t.pilotCta}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline type="application/json" id="teach-data" set:html={jsonData}></script>

<script is:inline>
  // Answer "which lesson is it today?" for the visitor's own date. The
  // server-rendered result is the build date's answer (kept as the no-JS
  // fallback); recompute here so the widget never goes stale after deploy.
  // Mirrors schoolDayForToday / isSchoolActive / lessonForSchoolDay in
  // src/lib/teachToday.ts (180 weekdays from September, no holidays).
  (function () {
    var el = document.getElementById('teach-data');
    if (!el) return;
    var data;
    try {
      data = JSON.parse(el.textContent || '{}');
    } catch (e) {
      return;
    }
    var catalog = data.catalog || {};
    var copy = data.copy || {};
    var fallback = data.fallback || {};
    var select = document.getElementById('grade-select');
    var resultEl = document.getElementById('teach-result');
    if (!select || !resultEl) return;

    function pad2(n) {
      return String(n).padStart(2, '0');
    }
    function gradePath(g) {
      return '/curriculum/' + pad2(g) + '/';
    }
    function unitPath(id) {
      var m = /^U\.(\d+)\.(\d+)$/.exec(id || '');
      if (!m) return '/curriculum/';
      return '/curriculum/' + pad2(m[1]) + '/' + pad2(m[2]) + '/';
    }
    function lessonPath(id) {
      var m = /^L\.(\d+)\.(\d+)\.(\d+)$/.exec(id || '');
      if (!m) return '/curriculum/';
      return '/curriculum/' + pad2(m[1]) + '/' + pad2(m[2]) + '/' + pad2(m[3]) + '/';
    }
    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
    function schoolYearStart(year) {
      var s = new Date(year, 8, 1);
      var dow = s.getDay();
      var offset = dow === 0 ? 1 : dow === 6 ? 2 : 0;
      return new Date(year, 8, 1 + offset);
    }
    function dayCount(today) {
      var t = new Date(today.getFullYear(), today.getMonth(), today.getDate());
      var s = schoolYearStart(t.getFullYear());
      if (t < s) s = schoolYearStart(t.getFullYear() - 1);
      if (t < s) return 0;
      var day = 0;
      var c = new Date(s);
      while (c <= t) {
        var w = c.getDay();
        if (w !== 0 && w !== 6) day += 1;
        c.setDate(c.getDate() + 1);
      }
      return day;
    }
    function notAuthoredHtml(g) {
      var names = copy.gradeNames || [];
      var label = names[g] || ('Grade ' + g);
      return (
        '<strong>' +
        esc(copy.notAuthored || '') +
        ' <a href="' +
        gradePath(g) +
        '">' +
        esc(label) +
        '</a> ' +
        esc(copy.browseFullYear || '') +
        '</strong>'
      );
    }
    function htmlFor(g) {
      var gd = catalog[g];
      if (!gd) return fallback[g] || notAuthoredHtml(g);
      var day = dayCount(new Date());
      var active = day >= 1 && day <= 180;
      var schoolDay = active ? Math.min(180, day) : 1;
      var unit = null;
      for (var i = 0; i < gd.units.length; i++) {
        var u = gd.units[i];
        if (schoolDay >= u.start && schoolDay <= u.end) {
          unit = u;
          break;
        }
      }
      if (!unit) return fallback[g] || notAuthoredHtml(g);
      var list = gd.lessons[unit.id] || [];
      if (!list.length) return fallback[g] || notAuthoredHtml(g);
      var span = unit.end - unit.start + 1;
      var idx = Math.max(
        0,
        Math.min(list.length - 1, Math.floor(((schoolDay - unit.start) / span) * list.length)),
      );
      var lesson = list[idx];
      var lead = active
        ? '<strong>' + esc(copy.todayIs || '') + ' ' + schoolDay + '.</strong> ' + esc(copy.thisWeek || '')
        : '<strong>' + esc(copy.comingSoon || '') + '</strong> ' + esc(copy.firstLesson || '');
      return (
        lead +
        ' <a href="' +
        unitPath(unit.id) +
        '">' +
        esc(unit.title) +
        '</a> &mdash; <a href="' +
        lessonPath(lesson[0]) +
        '">' +
        esc(lesson[1]) +
        '</a>'
      );
    }

    function show() {
      resultEl.innerHTML = htmlFor(select.value);
      resultEl.classList.add('teach-today__result--changed');
      setTimeout(function () { resultEl.classList.remove('teach-today__result--changed'); }, 400);
    }

    var q = new URLSearchParams(window.location.search).get('grade');
    if (q !== null && (catalog[q] || fallback[q])) select.value = q;
    show();

    select.addEventListener('change', show);
  })();
</script>
