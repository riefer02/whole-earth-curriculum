---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { ui } from '../../../../i18n';
import { domainPath, unitPath, lessonPath } from '../../../../lib/links';
import { pillarValue } from '../../../../lib/filters';
import { gradeKeyLabel, objectivesForStrand } from '../../../../lib/standards';
import { strandToLessons, strandToUnits } from '../../../../lib/enactments';
import { breadcrumbJsonLd } from '../../../../lib/seo';

export async function getStaticPaths() {
  const domains = await getCollection('domains');
  const paths: Array<{ params: { domain: string; strand: string } }> = [];
  for (const d of domains) {
    if (!d.id) continue;
    for (const s of d.data.strands ?? []) {
      if (!s.id) continue;
      const strandSlug = s.id.split('.')[1]?.toLowerCase() ?? '';
      paths.push({ params: { domain: d.id.toLowerCase(), strand: strandSlug } });
    }
  }
  return paths;
}

const { domain: domainSlug, strand: strandSlug } = Astro.params;
const domainId = (domainSlug ?? '').toUpperCase();
const strandId = `${domainId}.${(strandSlug ?? '').toUpperCase()}`;

const [domainEntry, lessons, units] = await Promise.all([
  getEntry('domains', domainId),
  getCollection('lessons'),
  getCollection('units'),
]);
if (!domainEntry) return Astro.redirect('/standards/');

const strand = (domainEntry.data.strands ?? []).find((s) => s.id === strandId);
if (!strand) return Astro.redirect(domainPath(domainId));

const objectives = objectivesForStrand(
  domainEntry.data.grade_objectives ?? {},
  strandId,
);

// Reverse index: which units and lessons enact this strand, grouped by unit.
const enactingLessons = strandToLessons(lessons).get(strandId) ?? [];
const enactingUnits = strandToUnits(units).get(strandId) ?? [];

const unitById = new Map<string, CollectionEntry<'units'>>();
for (const u of units) {
  if (u.data.id) unitById.set(u.data.id, u);
}

const lessonLists = new Map<string, CollectionEntry<'lessons'>[]>();
const order: string[] = [];

for (const lesson of enactingLessons) {
  const unitId = lesson.data.unit;
  if (!unitId) continue;
  if (!lessonLists.has(unitId)) {
    lessonLists.set(unitId, []);
    order.push(unitId);
  }
  lessonLists.get(unitId)!.push(lesson);
}

for (const unit of enactingUnits) {
  const unitId = unit.data.id;
  if (!unitId) continue;
  if (!lessonLists.has(unitId)) {
    lessonLists.set(unitId, []);
    order.push(unitId);
  }
}

const unitGroups = order.map((unitId) => {
  const unit = unitById.get(unitId);
  const groupLessons = lessonLists.get(unitId) ?? [];
  const grade = unit?.data.grade ?? groupLessons[0]?.data.grade ?? 0;
  return { unitId, unit, lessons: groupLessons, grade };
});

unitGroups.sort((a, b) => {
  if (a.grade !== b.grade) return a.grade - b.grade;
  return a.unitId.localeCompare(b.unitId);
});

const title = `${strandId} — ${strand.title}`;
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const crumbs = [
  { label: ui.nav.standards, href: '/standards/' },
  { id: `${domainId} — `, label: domainEntry.data.title, href: domainPath(domainId) },
  { id: strandId },
];
const jsonLd = pageUrl ? breadcrumbJsonLd(crumbs, pageUrl) : undefined;
const pagefindFilters = [
  'type:Standard',
  `domain:${domainEntry.data.title}`,
  `strand:${strand.title}`,
  ...(domainEntry.data.pillar ?? []).map((p) => `pillar:${pillarValue(p)}`),
];
---

<BaseLayout title={title} description={strand.description} pagefindFilters={pagefindFilters} jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />

    <h1 class="page-title">{strand.title}</h1>
    <div class="badge-row">
      <span class="badge id">{strandId}</span>
      {(domainEntry.data.pillar ?? []).map((p) => (
        <span class={`badge badge--pillar-${p}`}>
          {p}: {ui.pillarTitles[p] ?? p}
        </span>
      ))}
    </div>
    <p class="lede">{strand.description}</p>

    <h2 class="page-title" style="font-size:1.4rem; margin-top:2rem">{ui.common.verticalLadder}</h2>
    <ul class="ladder">
      {objectives.map((o) => (
        <li id={o.id.toUpperCase()}>
          <span class="grade-key">{gradeKeyLabel(o.gradeKey)}</span>
          <span class="obj-id id">{o.id}</span>
          <span>{o.text}</span>
        </li>
      ))}
    </ul>

    {
      unitGroups.length > 0 && (
        <>
          <h2 class="page-title" style="font-size:1.4rem; margin-top:2rem">{ui.common.taughtIn}</h2>
          {unitGroups.map((g) => (
            <div class="strand-block">
              <h3 class="card__title" style="font-size:1.1rem">
                {g.unit ? (
                  <a href={unitPath(g.unitId)}>
                    {ui.gradeLabel(g.grade)} · {g.unit.data.title ?? g.unitId}
                  </a>
                ) : (
                  <span>{g.unitId}</span>
                )}
              </h3>
              {g.lessons.length > 0 && (
                <ol class="timeline">
                  {g.lessons.map((l) => (
                    <li>
                      <span class="days">{l.data.sequence_in_unit ?? ''}</span>
                      <a href={lessonPath(l.data.id ?? '')}>{l.data.title ?? l.data.id}</a>
                    </li>
                  ))}
                </ol>
              )}
            </div>
          ))}
        </>
      )
    }
  </div>
</BaseLayout>
