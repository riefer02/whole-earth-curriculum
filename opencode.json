      "prompt": "{file:./agents/prompts/global-culture-editor.md}",
      "permission": { "edit": "allow", "bash": "allow", "webfetch": "allow", "task": "deny" }
    },
    "accessibility-editor": {
      "description": "Ensure UDL, inclusion, and low-tech/no-tech accessibility.",
      "mode": "subagent",
      "prompt": "{file:./agents/prompts/accessibility-editor.md}",
      "permission": { "edit": "allow", "bash": "allow", "task": "deny" }
    },
    "alignment-auditor": {
      "description": "Audit the cross-cutting lenses and traceability.",
      "mode": "subagent",
      "prompt": "{file:./agents/prompts/alignment-auditor.md}",
      "permission": { "edit": "allow", "bash": "allow", "task": "deny" }
    },
    "integrator": {
      "description": "Merge approved work and keep indexes/state coherent.",
      "mode": "subagent",
      "prompt": "{file:./agents/prompts/integrator.md}",
      "permission": { "edit": "allow", "bash": "allow", "task": "deny" }
    }
