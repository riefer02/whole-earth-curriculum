{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newworldorder.edu/schema/unit.schema.json",
  "title": "Unit",
  "description": "A coherent multi-lesson block of instruction.",
  "type": "object",
  "required": ["kind", "id", "title", "grade", "domain", "objectives", "status"],
  "properties": {
    "kind": { "const": "unit" },
    "id": { "type": "string", "pattern": "^U\\.\\d{2}\\.\\d{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "grade": { "type": "integer", "minimum": 0, "maximum": 12 },
    "domain": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^D\\d{2}$" }
    },
    "pillar": {
      "type": "array",
      "items": { "type": "string", "pattern": "^P[1-4]$" }
    },
    "strand": {
      "type": "array",
      "items": { "type": "string", "pattern": "^D\\d{2}\\.S\\d+$" }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^D\\d{2}\\.S\\d+\\.(K|\\d{2})\\.\\d{2}$" }
    },
    "essential_questions": { "type": "array", "items": { "type": "string" } },
    "big_ideas": { "type": "array", "items": { "type": "string" } },
    "duration_weeks": { "type": "number", "minimum": 0.5 },
    "assessment_plan": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "review", "approved"] },
    "author": { "type": "string" },
    "last_updated": { "type": "string" }
  },
  "additionalProperties": true
}
