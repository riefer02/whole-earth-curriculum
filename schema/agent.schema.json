{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newworldorder.edu/schema/agent.schema.json",
  "title": "Agent",
  "description": "A curriculum-building agent definition.",
  "type": "object",
  "required": ["kind", "id", "name", "role", "goal", "objectives", "inputs", "outputs", "done_criteria"],
  "properties": {
    "kind": { "const": "agent" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "done_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "prompt": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
