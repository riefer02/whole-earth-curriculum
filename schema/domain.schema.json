{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newworldorder.edu/schema/domain.schema.json",
  "title": "Domain",
  "description": "A content domain: its strands and grade-level objectives (the vertical spine).",
  "type": "object",
  "required": ["kind", "id", "title", "pillar", "strands", "status"],
  "properties": {
    "kind": { "const": "domain" },
    "id": { "type": "string", "pattern": "^D\\d{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "pillar": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^P[1-4]$" }
    },
    "description": { "type": "string" },
    "rationale": { "type": "string" },
    "strands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^D\\d{2}\\.S\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "grade_objectives": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "properties": {
            "id": { "type": "string", "pattern": "^D\\d{2}\\.S\\d+\\.(K|\\d{2})\\.\\d{2}$" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cross_cutting_lenses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": { "type": "string", "enum": ["draft", "review", "approved"] },
    "author": { "type": "string" },
    "last_updated": { "type": "string" }
  },
  "additionalProperties": true
}
