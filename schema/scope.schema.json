{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newworldorder.edu/schema/scope.schema.json",
  "title": "Scope",
  "description": "A grade's year plan (~180 days) mapping units to days and domains.",
  "type": "object",
  "required": ["kind", "grade", "year_title", "units", "status"],
  "properties": {
    "kind": { "const": "scope" },
    "grade": { "type": "integer", "minimum": 0, "maximum": 12 },
    "year_title": { "type": "string", "minLength": 1 },
    "total_school_days": { "type": "integer", "minimum": 1, "default": 180 },
    "summary": { "type": "string" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "title", "start_day", "end_day"],
        "properties": {
          "unit_id": { "type": "string", "pattern": "^U\\.\\d{2}\\.\\d{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "domain": { "type": "array", "items": { "type": "string", "pattern": "^D\\d{2}$" } },
          "pillar": { "type": "array", "items": { "type": "string", "pattern": "^P[1-4]$" } },
          "start_day": { "type": "integer", "minimum": 1 },
          "end_day": { "type": "integer", "minimum": 1 },
          "lesson_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "domain_weighting": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "assessment_plan": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "review", "approved"] },
    "author": { "type": "string" },
    "last_updated": { "type": "string" }
  },
  "additionalProperties": true
}
